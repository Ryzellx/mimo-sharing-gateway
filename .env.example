# === Runtime ===
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# === Database ===
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
DATABASE_POOL_MAX=10

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Auth / Secrets ===
# JWT signing secret. Minimum 32 chars in production.
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
# Used to encrypt Mimo API tokens at rest (AES-256-GCM).
# Provide a 32-byte base64 value, or any long random string (hashed to 32 bytes).
ENCRYPTION_KEY=change-me-to-another-long-random-string-32c

# === Upstream Mimo ===
# NOTE: account/quota/models endpoints are integration points. If your Mimo
# deployment exposes them, set the *_PATH values below; otherwise those
# features report "not configured" instead of guessing endpoints.
MIMO_API_URL=https://api.mimo.example/v1
MIMO_API_TOKEN=
MIMO_CHAT_PATH=/chat/completions
MIMO_ACCOUNT_PATH=
MIMO_USAGE_PATH=
MIMO_MODELS_PATH=

# === Gateway ===
CORS_ORIGIN=http://localhost:5173
# Quota mode: "allocation" (per-user split, default) or "shared_pool"
QUOTA_MODE=allocation
# Seconds a quota reservation stays valid before being reclaimed
RESERVATION_TTL_SECONDS=600
# Default max output tokens used for reservation estimates
DEFAULT_MAX_TOKENS=2048
# Background reconciliation interval (seconds)
SYNC_INTERVAL_SECONDS=180
# Rate limits applied to gateway API keys (per user)
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=1000
# Upstream request timeout (ms)
UPSTREAM_TIMEOUT_MS=120000

# === Admin bootstrap (creates first admin if none exists) ===
BOOTSTRAP_ADMIN_EMAIL=admin@gateway.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Admin-1!
BOOTSTRAP_ADMIN_USERNAME=admin
